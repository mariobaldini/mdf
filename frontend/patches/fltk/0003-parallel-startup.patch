+#include <functional>
+// Bounded retention of borrowed protocol callbacks, with lossless saturation.
+// Callers copy variable-length protocol data before constructing a callback.
+class MdfInputQueue {
+  std::deque<std::function<void()> > events_;
+  size_t capacity_;
+public:
+  explicit MdfInputQueue(size_t capacity = 1024) : capacity_(capacity) {}
+  bool empty() const { return events_.empty(); }
+  bool saturated() const { return events_.size() > capacity_; }
+  void clear() { events_.clear(); }
+  void push(std::function<void()> event) { events_.push_back(std::move(event)); }
+  void replay(const std::function<bool(bool)> &ready,
+              const std::function<void()> &schedule, bool wait = false) {
+    while (!events_.empty()) {
+      if (!ready(wait)) return;
+      std::function<void()> event = std::move(events_.front());
+      events_.pop_front();
+      // Pop and arrange continuation before invoking application code. A
+      // shortcut can run a nested modal event loop that must deliver releases.
+      if (!events_.empty()) schedule();
+      event();
+    }
+  }
+};
