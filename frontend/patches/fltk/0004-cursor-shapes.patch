+    case FL_CURSOR_WAIT: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_WAIT; break;
+    case FL_CURSOR_INSERT: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_TEXT; break;
+    case FL_CURSOR_HAND: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_POINTER; break;
+    case FL_CURSOR_HELP: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_HELP; break;
+    case FL_CURSOR_MOVE: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_MOVE; break;
+    case FL_CURSOR_N: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_N_RESIZE; break;
+    case FL_CURSOR_S: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_S_RESIZE; break;
+    case FL_CURSOR_E: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_E_RESIZE; break;
+    case FL_CURSOR_W: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_W_RESIZE; break;
+    case FL_CURSOR_NS: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NS_RESIZE; break;
+    case FL_CURSOR_WE: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_EW_RESIZE; break;
+    case FL_CURSOR_SW: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_SW_RESIZE; break;
+    case FL_CURSOR_SE: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_SE_RESIZE; break;
