+    case FL_CURSOR_NESW: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NESW_RESIZE; break;
+    case FL_CURSOR_NWSE: shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NWSE_RESIZE; break;
+    case FL_CURSOR_NONE: shape = 0; break;
+    default: return 0;
+  }
+  seat->mdf_cursor = cursor;
+  // A valid enter serial is required. Before enter, remember the selection;
+  // pointer_enter() calls do_set_cursor again with the compositor's serial.
+  if (seat->pointer_focus && seat->pointer_enter_serial) {
