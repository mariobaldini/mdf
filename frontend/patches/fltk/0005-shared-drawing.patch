+void Fl_Wayland_Graphics_Driver::mdf_make_writable(wld_buffer *buffer) {
+  if (!buffer->mdf_shared_drawing || !buffer->in_use) return;
+  MDF_TRACE("Detach drawing from compositor-owned buffer");
+  // Once committed, wl_shm pixels belong to the compositor until release.
+  // Recreate the normal private Cairo surface before any further drawing.
+  // Window::make_current resets its transform, line state and clip below.
+  cairo_t *previous = buffer->draw_buffer.cairo_;
+  cairo_surface_flush(cairo_get_target(previous));
+  const int width = buffer->draw_buffer.width, stride = buffer->draw_buffer.stride;
+  const int height = buffer->draw_buffer.data_size / stride;
+  cairo_init(&buffer->draw_buffer, width, height, stride, cairo_format);
+  memcpy(buffer->draw_buffer.buffer, buffer->data, buffer->draw_buffer.data_size);
+  cairo_surface_mark_dirty(cairo_get_target(buffer->draw_buffer.cairo_));
+  buffer->mdf_shared_drawing = false;
+  cairo_destroy(previous);
 }
 
 
