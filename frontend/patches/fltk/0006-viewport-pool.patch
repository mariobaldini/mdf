+size_t Fl_Wayland_Graphics_Driver::mdf_pool_size(size_t bytes, bool compact) {
+  // Wayland's pool size and buffer offsets use signed 32-bit integers.
+  const size_t page = 4096, maximum = size_t(INT_MAX) & ~(page - 1);
+  if (!bytes || bytes > maximum) return 0;
+  if (compact) return (bytes + page - 1) & ~(page - 1);
+  if (bytes <= 10000000) return 10000000;
+  return bytes <= maximum / 2 ? 2 * bytes : bytes;
+}
 
