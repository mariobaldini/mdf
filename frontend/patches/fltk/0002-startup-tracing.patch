--- /dev/null
+++ b/src/drivers/Wayland/mdf_startup.h
@@ -0,0 +1,25 @@
+// MDF hooks are private to the bundled build. See frontend/patches/fltk/README.md.
+#ifndef MDF_WAYLAND_STARTUP_H
+#define MDF_WAYLAND_STARTUP_H
+#include <stdint.h>
+extern "C" {
+uint64_t fl_mdf_trace_begin(const char *, const char *, int) __attribute__((weak));
+void fl_mdf_trace_end(const char *, const char *, int, uint64_t) __attribute__((weak));
+void fl_mdf_buffer_committed(void *) __attribute__((weak));
+}
+class MdfTrace {
+  const char *name_, *file_;
+  int line_;
+  uint64_t start_;
+public:
+  MdfTrace(const char *name, const char *file, int line)
+    : name_(name), file_(file), line_(line),
+      start_(fl_mdf_trace_begin ? fl_mdf_trace_begin(name, file, line) : 0) {}
+  ~MdfTrace() {
+    if (start_ && fl_mdf_trace_end) fl_mdf_trace_end(name_, file_, line_, start_);
+  }
+};
+#define MDF_TRACE_JOIN_(a,b) a##b
+#define MDF_TRACE_JOIN(a,b) MDF_TRACE_JOIN_(a,b)
+#define MDF_TRACE(name) MdfTrace MDF_TRACE_JOIN(mdf_trace_,__LINE__)(name,__FILE__,__LINE__)
+#endif
